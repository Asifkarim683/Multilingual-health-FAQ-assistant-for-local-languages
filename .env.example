# Server configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# LLM Provider configuration: 'gemini' | 'openai' | 'groq' | 'mock'
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Embedding Provider: 'gemini' | 'sentence_transformers' | 'multilingual_e5' | 'tfidf'
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/text-embedding-004

# Retrieval Configuration
TOP_K=5
CONFIDENCE_THRESHOLD=0.45

# Database / Storage
DATABASE_URL=sqlite:///./health_faq.db
VECTOR_STORE_PATH=./data/vector_store
